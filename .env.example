# =============================================================================
# STANDARDS ANALYZER - ENVIRONMENT VARIABLES
# =============================================================================

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service role key (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Prisma database connection string
# Format: postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[password]@db.your-project-id.supabase.co:5432/postgres

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Node environment
NODE_ENV=development

# Application URL (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL: Z.AI SDK CONFIGURATION
# =============================================================================
# Only needed if you have custom Z.ai configuration
# ZAI_API_KEY=your-zai-api-key

# =============================================================================
# SECURITY
# =============================================================================
# Secret for session management (generate a random string)
NEXTAUTH_SECRET=your-random-secret-string-here

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual Supabase credentials
# 3. Never commit .env to version control
# 4. For production, use environment variables in your deployment platform